# Supabase credentials for the UFA MVP Race dashboard and the prediction API.
# Copy to .env and fill in from your project's dashboard:
#   Project Settings -> API
#
# Never commit .env - .gitignore keeps it out; only this example is tracked.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Public "anon" key. Safe to ship to the browser: make_site.py bakes it into
# site/index.html, and row-level security limits it to SELECT on the five
# dashboard tables. api.py reads its rows with this key too - it only ever
# SELECTs, so it needs nothing stronger.
SUPABASE_ANON_KEY=

# Optional. api.py prefers SUPABASE_KEY when it is set, and falls back to
# SUPABASE_ANON_KEY above - so leave this blank unless a deployment wants the
# plainer name. It should hold the anon key, never the service_role key.
SUPABASE_KEY=

# Secret "service_role" key. Server-side only - it bypasses row-level security.
# Used solely by push_supabase.py to load the dataset. Never expose it publicly,
# and never put it in a Modal Secret: the API has no reason to write.
SUPABASE_SERVICE_ROLE_KEY=

# API key for the Modal-hosted MVP prediction API (modal_api.py). This is the
# password on the API - without it, anyone who finds the URL can spend your Modal
# credits. Every route except /health requires it. Generate one with:
#   python -c "import secrets;print('ufa_'+secrets.token_urlsafe(32))"
# The SAME value goes into Modal and Supabase:
#   modal secret create ufa-mvp-api-key MVP_API_KEY=<key>
#   supabase secrets set MODAL_API_KEY=<key>
MVP_API_KEY=

# How long (seconds) a warm API container may serve rows before re-reading
# Supabase. Blank means 300. Lower it if you push data often and want it live
# sooner; the cost is one PostgREST round trip per table per window.
MVP_CACHE_SECONDS=

# The deployed Modal URL, for the mvp-proxy edge function:
#   supabase secrets set MODAL_API_URL=https://<workspace>--ufa-mvp-api-fastapi-app.modal.run
MODAL_API_URL=
